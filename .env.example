# Copie este arquivo para .env e preencha os valores antes de rodar docker compose up
# O arquivo .env nunca deve ser commitado no git

# ─── SQL Server ───────────────────────────────────────────────────────────────
# Senha do usuário sa. Se a API rodar fora do Docker (dotnet run), a senha da connection
# string do appsettings.Development.json precisa coincidir com este valor.
SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Developer

# ─── API / ASP.NET Core ───────────────────────────────────────────────────────
# Atenção: o docker-compose.override.yml (carregado automaticamente por `docker compose up`)
# força Development no serviço da API. Para produção use `docker compose -f docker-compose.yml up`.
ASPNETCORE_ENVIRONMENT=Production
# Chave JWT (mínimo 32 caracteres em produção)
JWT_SECRET=your-production-jwt-secret-min-32-chars
# Executa migrations automaticamente no startup da API
ASPNETCORE_RUN_MIGRATIONS=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Vazio = URL relativa (funciona via proxy Nginx). Use URL absoluta se a API
# estiver em domínio diferente: https://api.meudominio.com
FRONTEND_API_BASE_URL=

# ─── Portas (host:container) ──────────────────────────────────────────────────
# Porta do SQL Server publicada no host. 14330 é a porta usada pelo
# docker-compose.override.yml e pelo appsettings.Development.json: a API rodando
# FORA do Docker (dotnet run) conecta em localhost,14330. Se mudar este valor,
# ajuste também a connection string do appsettings.Development.json.
# Dentro da rede do Docker a API sempre usa db,1433 (não depende desta variável).
DB_PORT=14330
API_PORT=5000
FRONTEND_PORT=80
