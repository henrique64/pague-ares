# Copie este arquivo para .env e preencha os valores antes de rodar docker compose up
# O arquivo .env nunca deve ser commitado no git

# ─── SQL Server ───────────────────────────────────────────────────────────────
SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Developer

# ─── API / ASP.NET Core ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# Chave JWT (mínimo 32 caracteres em produção)
JWT_SECRET=your-production-jwt-secret-min-32-chars
# Executa migrations automaticamente no startup da API
ASPNETCORE_RUN_MIGRATIONS=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Vazio = URL relativa (funciona via proxy Nginx). Use URL absoluta se a API
# estiver em domínio diferente: https://api.meudominio.com
FRONTEND_API_BASE_URL=

# ─── Portas (host:container) ──────────────────────────────────────────────────
DB_PORT=1433
API_PORT=5000
FRONTEND_PORT=80
